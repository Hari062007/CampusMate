# ==============================================================================
# CAMPUSMATE ENVIRONMENT CONFIGURATION (SAMPLE TEMPLATE)
# Copy this file to '.env' and fill in your values for local or cloud deployment.
# ==============================================================================

# Server Port (Render sets this automatically; defaults to 5000 locally)
PORT=5000

# Secret key for session security (use a long random alphanumeric string)
FLASK_SECRET_KEY=change_this_to_a_random_secret_key_for_production

# ==============================================================================
# SUPABASE POSTGRESQL & AUTH CONFIGURATION
# (Leave empty to run in Local Offline SQLite mode with campusmate.db)
# ==============================================================================

# Your Supabase Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Used server-side by Flask for admin operations & auth)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Supabase Anonymous Public Key (Optional server fallback)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon (public)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
